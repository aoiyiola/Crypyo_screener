## Copy this file to `.env` and fill in the values.
# Do NOT commit your real `.env` to version control.

# Telegram bot token (from BotFather)
TELEGRAM_TOKEN=

# Telegram chat ID (group/channel ID or user ID)
CHAT_ID=

# Optional: HuggingFace API key (if used elsewhere in your code)
HUGGINGFACE_API_KEY=
